# =========================================================
# Reveal Astro — environment variables
# =========================================================
# Copy this file to .env (gitignored) and fill in values.
# Public values are inlined into the static build at build time.
# =========================================================


# -------------------------------------------------------
# Site
# -------------------------------------------------------
# Origin used for canonical URLs, OG tags, and sitemap entries.
# Override per-environment: localhost in dev, astro-staging.revealbi.io in staging,
# www.revealbi.io in prod.
PUBLIC_SITE_URL=http://localhost:4321


# -------------------------------------------------------
# Endpoints (replaces hardcoded hosts in components)
# -------------------------------------------------------
# Salesforce lead intake — every form on the site POSTs here.
#
# ⚠️ Leave EMPTY in normal staging/prod builds. When empty, leadTracker.js
# auto-routes based on the site's own hostname: a build hosted at a URL
# containing "staging" → staging.infragistics.com; otherwise →
# www.infragistics.com. Setting a fixed value here disables that auto-routing,
# which means a staging build with PUBLIC_LEAD_API_BASE=https://www.infragistics.com
# would silently post leads to PROD. Only set this when you genuinely want
# to override (e.g. point at a test endpoint).
PUBLIC_LEAD_API_BASE=
# Staging override (used when PUBLIC_DEPLOY_ENV=staging).
PUBLIC_LEAD_API_BASE_STAGING=https://acctapis.staging.infragistics.com
# Lead tracking endpoint path appended to the resolved API host.
PUBLIC_LEAD_TRACKING_PATH=https://staging.infragistics.com/api/leadtrackingevents/track

# Marketing CDN — hero/logo/icon/badge images served from here.
PUBLIC_CDN_BASE=https://static.infragistics.com/marketing/reveal

# Help center — header "Help" link and footer documentation link.
PUBLIC_HELP_URL=https://help.revealbi.io

# Public-facing support address (rendered in error messages, footer).
PUBLIC_SUPPORT_EMAIL=support@revealbi.io

# Optional: which env this build represents — controls staging vs prod
# endpoint selection in leadTracker config. Values: production | staging | dev.
PUBLIC_DEPLOY_ENV=production

# Block search-engine indexing. "1" (or anything non-"0") emits the
# <meta name="robots" content="noindex,nofollow"> tag in BaseLayout and makes
# /robots.txt say Disallow: /. "0" allows indexing.
# Default for committed env files: 1 on staging, 0 on production.
PUBLIC_NOINDEX=0


# -------------------------------------------------------
# Analytics / tracking (all optional — empty disables)
# -------------------------------------------------------
# Google Analytics 4 — measurement ID, e.g. G-XXXXXXXXXX
PUBLIC_GA4_MEASUREMENT_ID=

# Google Tag Manager — container ID, e.g. GTM-XXXXXXX (alternative to GA4 if
# GTM manages the GA tag).
PUBLIC_GTM_CONTAINER_ID=GTM-PTZT5MD

# LinkedIn Insight Tag — partner ID (B2B remarketing).
PUBLIC_LINKEDIN_PARTNER_ID=

# Meta / Facebook Pixel — pixel ID (only if running paid social).
PUBLIC_META_PIXEL_ID=

# Hotjar — site ID for session recording / heatmaps.
PUBLIC_HOTJAR_SITE_ID=

# HubSpot — portal ID for tracking integration.
PUBLIC_HUBSPOT_PORTAL_ID=

# Google reCAPTCHA v3 — site key. Wires up bot protection on lead forms.
PUBLIC_RECAPTCHA_SITE_KEY=


# -------------------------------------------------------
# Search
# -------------------------------------------------------
# Provider name. Currently only "pagefind" is implemented; placeholder for
# future swap to Algolia / Google Programmable Search.
PUBLIC_SEARCH_PROVIDER=pagefind
