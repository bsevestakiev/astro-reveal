# Production environment values. Committed to the repo.
# Used by .github/workflows/deploy.yml when the main branch is pushed (copied to .env before build).
# AWS keys + bucket / distribution IDs live in the GitHub Actions "production"
# environment as scoped secrets — never put them here.

# -------------------------------------------------------
# Site
# -------------------------------------------------------
PUBLIC_SITE_URL=https://www.revealbi.io
PUBLIC_DEPLOY_ENV=production

# Allow indexing on production.
PUBLIC_NOINDEX=0

# -------------------------------------------------------
# Endpoints
# -------------------------------------------------------
# Empty → leadTracker.js auto-routes by hostname (production hosts resolve to
# www.infragistics.com). Set a value only after Salesforce confirms the
# correct host (acctapis.infragistics.com vs www.infragistics.com is
# unresolved — see docs/handoff/cutover-checklist.md §3.1).
PUBLIC_LEAD_API_BASE=
# Lead tracking endpoint path appended to the resolved API host.
PUBLIC_LEAD_TRACKING_PATH=https://www.infragistics.com/api/leadtrackingevents/track
PUBLIC_CDN_BASE=https://static.infragistics.com/marketing/reveal
PUBLIC_HELP_URL=https://help.revealbi.io
PUBLIC_SUPPORT_EMAIL=support@revealbi.io

# -------------------------------------------------------
# Analytics — fill in once marketing hands over the IDs
# -------------------------------------------------------
PUBLIC_GA4_MEASUREMENT_ID=
PUBLIC_GTM_CONTAINER_ID=GTM-WXWCMQZ
PUBLIC_LINKEDIN_PARTNER_ID=
PUBLIC_META_PIXEL_ID=
PUBLIC_HOTJAR_SITE_ID=
PUBLIC_HUBSPOT_PORTAL_ID=
PUBLIC_RECAPTCHA_SITE_KEY=6Lc-MFAaAAAAAIWi7UOrSUfUZnVmDUSsXjzS4BgY

# -------------------------------------------------------
# Search
# -------------------------------------------------------
PUBLIC_SEARCH_PROVIDER=pagefind
