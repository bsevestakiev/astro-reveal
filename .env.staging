# Staging environment values. Committed to the repo.
# Used by .github/workflows/deploy.yml when the staging branch is pushed (copied to .env before build).
# AWS keys + bucket / distribution IDs live in the GitHub Actions "staging"
# environment as scoped secrets — never put them here.

# -------------------------------------------------------
# Site
# -------------------------------------------------------
PUBLIC_SITE_URL=https://astro-staging.revealbi.io
PUBLIC_DEPLOY_ENV=staging

# Block search-engine indexing on staging.
PUBLIC_NOINDEX=1

# -------------------------------------------------------
# Endpoints
# -------------------------------------------------------
# Empty → leadTracker.js auto-routes by hostname (a host containing "staging"
# resolves to staging.infragistics.com). Override only to point at a test endpoint.
PUBLIC_LEAD_API_BASE=
PUBLIC_LEAD_API_BASE_STAGING=https://acctapis.staging.infragistics.com
# Lead tracking endpoint path appended to the resolved API host.
PUBLIC_LEAD_TRACKING_PATH=https://staging.infragistics.com/api/leadtrackingevents/track
PUBLIC_CDN_BASE=https://static.infragistics.com/marketing/reveal
PUBLIC_HELP_URL=https://help.revealbi.io
PUBLIC_SUPPORT_EMAIL=support@revealbi.io

# -------------------------------------------------------
# Analytics — staging stays empty so we don't pollute prod GA streams
# -------------------------------------------------------
PUBLIC_GA4_MEASUREMENT_ID=
PUBLIC_GTM_CONTAINER_ID=GTM-PTZT5MD
PUBLIC_LINKEDIN_PARTNER_ID=
PUBLIC_META_PIXEL_ID=
PUBLIC_HOTJAR_SITE_ID=
PUBLIC_HUBSPOT_PORTAL_ID=
PUBLIC_RECAPTCHA_SITE_KEY=6Lc-MFAaAAAAAIWi7UOrSUfUZnVmDUSsXjzS4BgY

# -------------------------------------------------------
# Search
# -------------------------------------------------------
PUBLIC_SEARCH_PROVIDER=pagefind
