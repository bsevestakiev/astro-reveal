import ResourceCardGrid from './sections/ResourceCardGrid.astro'
import { localizedHref } from '../lib/href'

interface Props {
  sections: any[]
  lang?: string
}

const { sections, lang } = Astro.props
const lh = (h?: string) => localizedHref(h ?? '', lang)

// Group consecutive sections that share the same `band` id into one wrapping
// <section>, so a page can put a shared background behind several blocks without
// changing those block components site-wide. Sections without `band` render as-is.
const bandGroups: { band: string | null; bandClass?: string; items: any[] }[] = []
for (const s of sections) {
  const band = s?.band ?? null
  const last = bandGroups[bandGroups.length - 1]
  if (band && last && last.band === band) last.items.push(s)
  else bandGroups.push({ band, bandClass: s?.bandClass, items: [s] })
}
---
{bandGroups.map((g: any) => {
  const rendered = g.items.map((s: any) => {
  if (s.type === 'hero') return (
    <Hero
      headline={s.headline}
