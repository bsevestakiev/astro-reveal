      paragraphs={s.paragraphs}
    />
  )
  if (s.type === 'demo-video-split') return (
    <DemoVideoSplit
      headline={s.headline}
      videoPoster={s.videoPoster}
      videoMp4={s.videoMp4}
      cardTitle={s.cardTitle}
      cardBody={s.cardBody}
      ctaLabel={s.ctaLabel}
      ctaHref={lh(s.ctaHref)}
      anchor={s.anchor}
    />
  )
  if (s.type === 'resource-card-grid') return (
    <ResourceCardGrid
      headline={s.headline}
      body={s.body}
      cards={(s.cards ?? []).map((c: any) => ({ ...c, href: lh(c.href) }))}
    />
  )
  return null
  })
  return g.band
    ? (<section class={g.bandClass ?? 'py-3 py-md-5 bg-color-light-gray'}>{rendered}</section>)
    : rendered
})}
