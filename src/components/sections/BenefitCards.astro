---
interface Card {
  icon?: string
  iconAlt?: string
  title: string
  body: string
}
interface Props {
  headline: string
  anchor?: string
  cards: Card[]
}

const { headline, anchor, cards } = Astro.props
const columns: Card[][] = [[], []]
cards.forEach((card, i) => columns[i % 2].push(card))
---

<section class="container">
  <header class="row">
    <div class="col text-center">
      <h2 class="pb-4" id={anchor} set:html={headline} />
    </div>
  </header>
  <div class="row mx-auto pb-3">
    {columns.map((col) => (
      <div class="col-sm-12 col-md-6">
        {col.map((card) => (
          <div class="p-3 border rounded-lg mb-4 h4">
            <div class="d-flex justify-content-start align-items-center mb-3">
              {card.icon && (
                <img alt={card.iconAlt ?? card.title} class="d-inline-block pt-1 mr-3 rounded-xl" decoding="async" src={card.icon} title={card.iconAlt ?? card.title} width="35" />
              )}
              <div class="h4 d-inline-block mb-0">
                <strong class="align-middle" set:html={card.title} />
              </div>
            </div>
            <p class="h5 small" style="line-height: 1.3;" set:html={card.body} />
          </div>
        ))}
      </div>
    ))}
  </div>
</section>
