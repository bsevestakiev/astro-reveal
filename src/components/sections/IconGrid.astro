---
interface Card {
  icon?: string
  iconAlt?: string
  title: string
  body: string
  iconStyle?: string
  listIntro?: string
  items?: string[]
  link?: string
  linkLabel?: string
  image?: string
  loadmore?: boolean
}
interface Props {
  eyebrow?: string
  headline: string
  subhead?: string
  subhead2?: string
  cards: Card[]
  variant?: 'white' | 'gray-card' | 'vborder' | 'feature-list' | 'bordered' | 'plain-center' | 'icon-inline'
  footnote?: string
  footnoteClass?: string
  iconSize?: number
  cardTitleTag?: 'h3' | 'p'
  cols?: 2 | 3 | 4
  anchor?: string
}

const {
  eyebrow,
  headline,
  subhead,
  subhead2,
  cards,
  variant = 'white',
  footnote,
  footnoteClass = 'h5 font-weight-bold mb-0',
  iconSize = 48,
  cardTitleTag = 'h3',
  cols = 4,
  anchor,
} = Astro.props

const bgClass = variant === 'gray-card' ? 'bg-light-gray-card' : ''
const isVborder = variant === 'vborder'
const isFeatureList = variant === 'feature-list'
const isBordered = variant === 'bordered'
const isPlainCenter = variant === 'plain-center'
// icon-inline: icon + title sit side-by-side at the top of an otherwise default card
const isIconInline = variant === 'icon-inline'
// Card wrapper style per variant — old prod uses a bordered, shadowless card for
// "Common Ways" and a borderless centered card for "Built for Scale".
const cardWrapClass = isBordered
  ? 'h-100 p-4 border rounded-lg bg-white'
  : isPlainCenter
  ? 'card h-100 border-0 text-center p-4 rounded-lg'
  : 'card h-100 border-0 shadow rounded-xl p-4'
const colClass = cols === 2 ? 'col-12 col-md-6' : cols === 3 ? 'col-12 col-md-6 col-lg-4' : 'col-12 col-md-6 col-lg-3'
const hasLoadmore = cards.some((c: Card) => c.loadmore)
---

<section id={anchor} class={isFeatureList
  ? 'container pb-5'
  : `py-5 overflow-hidden${variant !== 'gray-card' ? ' my-5' : ''}${bgClass ? ' ' + bgClass : ''}`}>
  <div class={isFeatureList ? '' : 'container'}>
    <div class={isFeatureList ? 'row py-4' : 'row animate-me'} data-animation={isFeatureList ? undefined : 'fadeInRight'}>
      <div class={isVborder ? 'col-md-12 text-center mb-5' : isFeatureList ? 'col text-center animate-me' : 'col-12 text-center mb-5'} data-animation={isFeatureList ? 'fadeInUp' : undefined}>
        {eyebrow && (
          <p class="text-uppercase text-french-rose font-weight-bold mb-3">{eyebrow}</p>
        )}
        <h2 class={isVborder ? 'pb-4' : isFeatureList ? '' : 'mb-4'} set:html={headline} />
        {subhead && <p class="mx-auto mw-900px">{subhead}</p>}
        {subhead2 && <p class="mx-auto mw-900px">{subhead2}</p>}
        <slot name="subhead" />
      </div>
    </div>

    {isFeatureList ? (
      <>
        <div class="row mw-900px mx-auto pb-3">
          {cards.map((card: Card, i: number) => (
            <div class="col-sm-12 col-md-6">
              <div class={`d-flex justify-content-start align-items-start pt-3 animate-me feature-item${card.loadmore ? ' loadmore-item d-md-flex' : ''}`} data-animation="slideDown" data-delay={`${(i + 1) * 0.1}s`}>
                {card.icon && (
                  <img loading="lazy" decoding="async" class="d-inline-block-d-md-none pt-1 mr-3"
                    src={card.icon} alt={card.iconAlt ?? card.title} title={card.title} width="35" height="35" />
                )}
                <p class="h4 d-inline-block mb-3">
                  <strong class="align-middle">{card.title}</strong>
                  <span class="d-block small mt-3 h5">{card.body}</span>
                </p>
              </div>
            </div>
          ))}
        </div>
        {hasLoadmore && (
          <div class="row d-md-none">
            <div class="col-12 text-center pt-4">
              <a href="#" class="btn btn-outline-primary load-more-btn">
                Load More <i class="fas fa-chevron-down ml-2"></i>
              </a>
            </div>
          </div>
        )}
      </>
    ) : isVborder ? (
      <div class="row vborder mw-900px mx-auto">
        {cards.map((card: Card, i: number) => (
          <div class={colClass}>
            <div class="animate-me" data-animation={i % 2 === 0 ? 'fadeInRight' : 'fadeInLeft'}>
              <h3 class="h5 font-weight-bold">{card.title}</h3>
              <p>{card.body}</p>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="row animate-me" data-animation="fadeInUp">
        {cards.map((card: Card) => (
          <div class={`${colClass} mb-4`}>
            <div class={cardWrapClass}>
              <div class="card-body p-0 d-flex flex-column">
                {isIconInline ? (
                  <div class="d-flex align-items-center mb-3">
                    {card.icon && (
                      <img loading="lazy" decoding="async" src={card.icon}
                           alt={card.iconAlt ?? card.title} title={card.title} width="30" />
                    )}
                    <h4 class="ml-3 mb-0" style="font-weight: 700;">{card.title}</h4>
                  </div>
                ) : isBordered ? (
                  <div class="d-flex flex-column flex-md-row align-items-center text-center text-md-left mb-3">
                    {card.icon && (
                      <img loading="lazy" decoding="async" class="mr-0 mr-md-3 mb-2 mb-md-0 rounded-xl" src={card.icon}
                           alt={card.iconAlt ?? card.title} title={card.title} width={iconSize} height={iconSize} />
                    )}
                    {cardTitleTag === 'p'
                      ? <p class="font-weight-bold mb-0">{card.title}</p>
                      : <h3 class="h5 font-weight-bold mb-0">{card.title}</h3>
                    }
                  </div>
                ) : (
                  <>
                    {card.icon && (
                      <div class={`mb-3${isPlainCenter ? ' justify-content-center' : ''}`} style={card.iconStyle ?? 'height:56px;display:flex;align-items:center'}>
                        <img loading="lazy" decoding="async" src={card.icon} alt={card.iconAlt ?? card.title}
                             title={card.title} width={iconSize} height={iconSize} />
                      </div>
                    )}
                    {cardTitleTag === 'p'
                      ? <p class="font-weight-bold">{card.title}</p>
                      : <h3 class="h5 font-weight-bold mb-3">{card.title}</h3>
                    }
                  </>
                )}
                <p class="mb-0">{card.body}</p>
                {card.listIntro && <p class="mb-2 mt-2">{card.listIntro}</p>}
                {card.items && card.items.length > 0 && (
                  <ul class="list-checkmark ai-tick mb-3">
                    {card.items.map((item: string) => <li>{item}</li>)}
                  </ul>
                )}
                {card.image && (
                  <img loading="lazy" decoding="async" src={card.image} alt={card.title} class="img-fluid w-100 mt-2" />
                )}
                {card.link && (
                  <a href={card.link} class="font-weight-bold anchor-blue mt-auto d-inline-block">
                    {card.linkLabel ?? 'Learn More →'}
                  </a>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    )}

    {footnote && (
      <div class="row animate-me" data-animation="fadeInRight">
        <div class="col-12 text-center mt-4">
          <p class={footnoteClass} set:html={footnote} />
        </div>
      </div>
    )}
  </div>
</section>

{isFeatureList && hasLoadmore && (
  <>
    <style>
      @media (max-width: 767.98px) {
        .loadmore-item {
          opacity: 0;
          transform: translateY(20px);
          transition: opacity 0.5s ease, transform 0.5s ease;
          display: none !important;
        }
        .loadmore-item.show {
          opacity: 1;
          transform: translateY(0);
          display: flex !important;
        }
      }
    </style>
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        const btn = document.querySelector('.load-more-btn');
        const items = document.querySelectorAll('.loadmore-item');
        if (!btn || !items.length) return;
        items.forEach(function (item) { item.classList.remove('show'); });
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          items.forEach(function (item) { item.classList.toggle('show'); });
          if (btn.innerHTML.includes('Load More')) {
            btn.innerHTML = 'Show Less <i class="fas fa-chevron-up ml-2"></i>';
          } else {
            btn.innerHTML = 'Load More <i class="fas fa-chevron-down ml-2"></i>';
          }
        });
      });
    </script>
  </>
)}
