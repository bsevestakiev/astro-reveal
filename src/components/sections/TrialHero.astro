---
import LeadCaptureForm from './LeadCaptureForm.astro'

interface Props {
  headline: string
  body?: string
  bullets?: string[]
  boldBullets?: boolean
  ctaLabel?: string
  ctaHref?: string
  image?: string
  imageAlt?: string
  imageSrcset?: { media: string; srcset: string }[]
  formAnchor?: string
  formId?: string
  cardTitle?: string
  cardHeaderClass?: string
  cardSubtext?: string
  showTitle?: boolean
  submitLabel?: string
  thankYouHtml?: string
  leadSourceNumber?: string
  eventType?: string
  eventDetail?: string
  googleEventLabel?: string
  redirectUrl?: string
}

const {
  headline,
  body,
  bullets = [],
  boldBullets = true,
  ctaLabel,
  ctaHref = '#download-sdk-form',
  image,
  imageAlt = '',
  imageSrcset = [],
  formAnchor = 'download-sdk-form',
  formId = 'lead-form_1',
  cardTitle,
  cardHeaderClass,
  cardSubtext,
  showTitle,
  submitLabel = 'Submit',
  thankYouHtml,
  leadSourceNumber,
  eventType,
  eventDetail,
  googleEventLabel,
  redirectUrl = '',
} = Astro.props

const srcsetAttr = imageSrcset.map(s => s.srcset).join(', ')
---

<div class="container">
  <div class="row justify-content-between">
    <div class="col-md-12 col-lg-5 mt-5 pr-3 pr-lg-5 pl-3 pl-md-0">
      <div class="row">
        <div class="col-md-12 mb-3">
          <h1 class="mb-3" set:html={headline} />
          {body && <Fragment set:html={body} />}
        </div>
        {bullets.length > 0 && (
          <ul class="list-checkmark fill-icon ml-3">
            {bullets.map(b => <li>{boldBullets ? <strong>{b}</strong> : b}</li>)}
          </ul>
        )}
        {ctaLabel && (
          <a class="btn btn-primary mb-3 mb-lg-2 mr-0 mr-sm-3" href={ctaHref}>{ctaLabel}</a>
        )}
      </div>
    </div>
    <div class="col-md-12 col-lg-6 mt-0 mt-md-5 mb-3 sidebar-right sidebar-right--header pr-3 pr-md-0">
      <div class="shadow overflow-hidden rounded-xl">
        <LeadCaptureForm
          variant="form-card"
          anchor={formAnchor}
          formId={formId}
          cardTitle={cardTitle}
          cardHeaderClass={cardHeaderClass}
          cardSubtext={cardSubtext}
          showTitle={showTitle}
          submitLabel={submitLabel}
          thankYouHtml={thankYouHtml}
          leadSourceNumber={leadSourceNumber}
          eventType={eventType}
          eventDetailParam={eventDetail}
          googleEventLabel={googleEventLabel}
          redirectUrl={redirectUrl}
        />
      </div>
    </div>
  </div>
  {image && (
    <img
      alt={imageAlt}
      class="b-lazy d-block d-md-none mt-4"
      decoding="async"
      sizes="(max-width: 768px) 100vw, (max-width: 1100px) and (min-width: 769px) 50vw, 600px"
      src={image}
      srcset={srcsetAttr || undefined}
      title={imageAlt}
    />
  )}
</div>
