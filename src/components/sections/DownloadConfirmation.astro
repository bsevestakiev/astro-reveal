---
interface Props {
  downloadUrl: string
  goalLabel?: string
  headline: string
  lead: string
  paragraphs: string[]
}

const { downloadUrl, goalLabel = 'Reveal SDK', headline, lead, paragraphs } = Astro.props
---

<script is:inline define:vars={{ dURL: downloadUrl, goalLabel }}>
function reloadDownload() { window.location = dURL; }
setTimeout(function () {
  reloadDownload();
  if (window.dataLayer) {
    window.dataLayer.push({ event: 'trackGoal', goalType: 'Completed Download', goalLabel: goalLabel });
  }
}, 1000);
document.addEventListener('click', function (e) {
  var link = e.target.closest && e.target.closest('.js-restart-download');
  if (link) { e.preventDefault(); reloadDownload(); }
});
</script>

<div class="container py-5 text-center">
  <h1 class="mb-4" set:html={headline} />
  <p class="lead" set:html={lead} />
  {paragraphs.map((p) => <p set:html={p} />)}
</div>
