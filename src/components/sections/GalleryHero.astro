---
interface SrcsetEntry {
  media: string
  srcset: string
}
interface Props {
  headline: string
  body?: string
  ctaLabel?: string
  ctaHref?: string
  image?: string
  imageAlt?: string
  imageSrcset?: SrcsetEntry[]
}

const { headline, body, ctaLabel, ctaHref, image, imageAlt = '', imageSrcset } = Astro.props
const srcset = imageSrcset && imageSrcset.length ? imageSrcset.map((e) => e.srcset).join(', ') : undefined
---

<div class="bg-color-gallery py-md-5 mb-md-5">
  <div class="jumbotron position-relative bg-transparent mb-0">
    <div class="container">
      <div class="align-items-center justify-content-center row">
        <div class="col-md-12 col-lg-6">
          <h1 set:html={headline} />
          {body && <p class="mb-4" set:html={body} />}
          {ctaLabel && (
            <a class="btn btn-primary mb-2 mr-0 mr-sm-3 trackCTA" data-xd-ga-action="Become a Partner" data-xd-ga-label="Reveal" href={ctaHref}>{ctaLabel}</a>
          )}
        </div>
        <div class="col-9 col-lg-6 mt-3 mt-lg-0">
          {image && (
            <img alt={imageAlt} class="img-fluid" decoding="async" fetchpriority="high" height="346" sizes="(max-width: 768px) 100vw, (max-width: 1100px) and (min-width: 769px) 50vw, 540px" src={image} srcset={srcset} title={imageAlt} width="540" />
          )}
        </div>
      </div>
    </div>
  </div>
</div>
