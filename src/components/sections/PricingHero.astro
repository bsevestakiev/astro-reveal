---
interface Props {
  headline: string
  subhead?: string
  features?: string[]
  ctaLabel?: string
  ratingsImage?: string
  dashboardImage?: string
  dashboardImageAlt?: string
  formHeadline?: string
  formSubhead?: string
}

const {
  headline,
  subhead,
  features = [],
  ctaLabel = 'Submit',
  ratingsImage,
  dashboardImage,
  dashboardImageAlt = 'Reveal embedded analytics dashboard',
  formHeadline = 'Request a Pricing Quote Today!',
  formSubhead = "Fill out this short form and we'll get in touch.",
} = Astro.props
---

<section class="py-5 overflow-hidden">
  <div class="container">
    <div class="row align-items-start justify-content-between">

      <!-- Left: headline + features + ratings + dashboard image -->
      <div class="col-md-12 col-lg-6 mt-5 pr-lg-5" style="display:flex;align-items:flex-start">
        <div class="row">
          <div class="col-md-12 mb-3">
            <h1 class="mb-3" set:html={headline} />
            {subhead && <p>{subhead}</p>}
          </div>
          {features.length > 0 && (
            <ul class="list-checkmark fill-icon ml-3" style="column-count:2;column-gap:3rem">
              {features.map((f: string) => <li><strong set:html={f} /></li>)}
            </ul>
          )}
          {ratingsImage && (
            <img class="mb-4" alt="Reveal Trust Ratings" src={ratingsImage}
                 style="max-height:50px" loading="lazy" decoding="async" />
          )}
          {dashboardImage && (
            <img class="d-none d-lg-block img-fluid" src={dashboardImage}
                 alt={dashboardImageAlt} title={dashboardImageAlt} loading="lazy" decoding="async" />
          )}
        </div>
      </div>

      <!-- Right: pink-header pricing-quote form card -->
      <div class="col-md-12 col-lg-6 mt-5 mb-3 text-center sidebar-right sidebar-right--header">
        <div class="shadow">
          <header class="text-white pb-3"
                  style="border-top-left-radius:0.5rem;border-top-right-radius:0.5rem;padding-top:2rem;background-color:#ec417a">
            <p class="h3"><strong>{formHeadline}</strong></p>
            <p class="text-0875 mb-0">{formSubhead}</p>
          </header>
          <div class="text-left pb-3 sidebar-card bg-white p-4"
               style="border-bottom-left-radius:0.5rem;border-bottom-right-radius:0.5rem">
            <form id="lead-form_pricing-quote" class="lead-tracker-form ui-form" novalidate>
              <div class="form-row mb-2">
                <div class="col-12">
                  <span class="ui-form__required-note small text-muted">Required</span>
                </div>
              </div>
              <div class="form-group mb-3">
                <label for="Email_pricing-quote">Business Email *</label>
                <input id="Email_pricing-quote" name="Email" type="email"
                       class="form-control sfInput required"
                       data-val-length-max="60" required />
              </div>
              <div class="form-group mb-3">
                <label for="FirstName_pricing-quote">First Name</label>
                <input id="FirstName_pricing-quote" name="FirstName" type="text"
                       class="form-control sfInput"
                       data-val-length-max="100" />
              </div>
              <div class="form-group mb-3">
                <label for="LastName_pricing-quote">Last Name</label>
                <input id="LastName_pricing-quote" name="LastName" type="text"
                       class="form-control sfInput"
                       data-val-length-max="100" />
              </div>
              <div class="form-group mb-3">
                <label for="Company_pricing-quote">Company</label>
                <input id="Company_pricing-quote" name="Company" type="text"
                       class="form-control sfInput"
                       data-val-length-min="2" data-val-length-max="50" />
              </div>
              <div class="form-group mb-3">
                <label for="Phone_pricing-quote">Phone</label>
                <input id="Phone_pricing-quote" name="Phone" type="tel"
                       class="form-control sfInput"
                       data-val-length-max="25" />
              </div>
              <div class="form-group mb-3">
                <div class="custom-control custom-checkbox">
                  <input id="acceptGDPR_pricing-quote" name="acceptGDPRFormSubmission"
                         type="checkbox" class="accept-gdpr custom-control-input" value="yes" required />
                  <label for="acceptGDPR_pricing-quote" class="custom-control-label small">
                    I understand and agree to the terms of Infragistics'
                    <a class="text-decoration-none font-weight-bolder" href="/terms-of-use">Terms of Use</a>
                    and
                    <a class="text-decoration-none font-weight-bolder" href="/privacy-policy">Privacy Policy</a>
                    <p class="mt-2 mb-0 label small text-muted">This site is protected by reCAPTCHA and the Google Privacy Policy and Terms of Use apply.</p>
                  </label>
                </div>
              </div>
              <div class="form-row">
                <div class="col col-lg text-center">
                  <button type="submit" class="submit btn rounded-pill btn-primary" disabled>{ctaLabel}</button>
                </div>
              </div>
            </form>
            <div class="thankyou__lead-form_pricing-quote" style="display:none;">
              <div class="text-center py-4">
                <h2 class="pb-3">Thank you!</h2>
                <p>Your information has been submitted. Our team will be contacting you shortly via email.</p>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script is:inline>
  window.addEventListener('load', function () {
    if (typeof leadTracker === 'undefined') return;
    if (!document.getElementById('lead-form_pricing-quote')) return;
    var cfg = window.__REVEAL_CONFIG__ || {};
    leadTracker.execute({
      macro: 'LeadTracker',
      lang: 'en',
      leadFormID: 'lead-form_pricing-quote',
      reaptchaKey: cfg.recaptchaSiteKey || '',
      redirectUrl: '',
      redirectMode: '_self',
      thankYouMessage: '1',
      formContainerId: '',
      productCode: 'A8',
      leadProductCode: '',
      packageName: '',
      productResourceType: '',
      osSupport: '',
      installerType: '',
      eventTypeParam: 'pricing quote',
      eventDetailParam: 'form submit',
      prohibitFreeMail: true,
      prohibitDisposableMail: true,
      showRequestDemo: false,
      googleEventType: 'Form Submit',
      googleEventLabel: 'Reveal - Embedded Pricing Request',
      googleEventTypeDownload: '',
      googleEventLabelDownload: '',
      zoomWebinarId: '',
      leadSourceNumber: 'A800005',
      tier: 'tier_1',
      formLocation: '',
      formValue: '2000',
      productName: 'Reveal',
      formName: 'form submit',
      cookiesPrefix: 'reveal_',
    });
  });
</script>
