---
interface Step {
  number: string
  label: string
  description: string
  icon: string
  iconAlt: string
  stepClass?: string
}

interface DataSource {
  icon: string
  label: string
}

interface Props {
  headline: string
  steps: Step[]
  dataSources?: DataSource[]
  footerText?: string
}

const { headline, steps, dataSources = [], footerText } = Astro.props

// Steps 1-3 go in the grouped left column; step 4 goes in the right column.
const stepsGroup = steps.slice(0, 3)
const stepEmbed = steps[3]
---

<section id="platform-reveal" class="py-5 cv-auto" style="background-color: #fbfbfc;">
  <div class="container py-lg-5">
    <h2 id="reveal-on-prem-analytics-platform" class="text-center mb-5 font-weight-bold" style="color: #2a2a2a; font-size: 2.5rem;" set:html={headline} />

    <div class="platform-card shadow">
      <div class="row no-gutters">
        <!-- Steps 1-3 -->
        <div class="col-md-9 position-relative">
          <div class="row no-gutters">
            {stepsGroup.map((step) => (
              <div class="col-md-4 platform-step px-md-4">
                <div class={`step-icon-wrapper${step.stepClass ? ' ' + step.stepClass : ''}`}>
                  <img decoding="async" loading="lazy" src={step.icon} alt={step.iconAlt} title="On Prem Analytics" />
                </div>
                <h4>{step.number}. {step.label}</h4>
                <p>{step.description}</p>
              </div>
            ))}
          </div>

          {dataSources.length > 0 && (
            <div class="row no-gutters d-none d-md-block">
              <div class="col-12 px-md-4">
                <div class="data-sources-box">
                  {dataSources.map((ds) => (
                    <div class="ds-item">
                      <img decoding="async" loading="lazy" src={ds.icon} alt={ds.label} title="On Prem Analytics" />
                      <span>{ds.label}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          )}

          <div class="d-none d-md-block" style="position: absolute; right: 0; top: 0; height: 100%; width: 1px; background: #e9ecef;"></div>

          {dataSources.length > 0 && (
            <div class="d-md-none mb-5">
              <div class="data-sources-box pb-0 mb-0">
                {dataSources.map((ds) => (
                  <div class="ds-item mb-3">
                    <img decoding="async" loading="lazy" src={ds.icon} alt={ds.label} title="On Prem Analytics" />
                    <span>{ds.label}</span>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>

        <!-- Step 4: Embed -->
        {stepEmbed && (
          <div class="col-md-3 platform-step px-md-4 border-0">
            <div class={`step-icon-wrapper${stepEmbed.stepClass ? ' ' + stepEmbed.stepClass : ''}`}>
              <img decoding="async" loading="lazy" src={stepEmbed.icon} alt={stepEmbed.iconAlt} title="On Prem Analytics" />
            </div>
            <h4>{stepEmbed.number}. {stepEmbed.label}</h4>
            <p>{stepEmbed.description}</p>
          </div>
        )}
      </div>
    </div>

    {footerText && (
      <div class="row justify-content-center">
        <div class="col-md-10">
          <p class="text-center platform-footer-text pt-4">{footerText}</p>
        </div>
      </div>
    )}
  </div>
</section>

<style is:global>
  .platform-card {
    background: #fff;
    border-radius: 20px;
    padding: 60px 40px;
    border: 1px solid rgba(0, 0, 0, 0.03);
}
  .platform-step {
    padding: 0 30px;
    position: relative;
    text-align: center;
}
.platform-step h4 {
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 20px;
    color: #222;
}
.platform-step p {
    font-size: .9rem;
    line-height: 1.2;
    margin-bottom: 0;
}
.step-1 {
    background-color: #ec417a;
}
.step-2 {
    background-color: #7a97fa;
}.step-3 {
    background-color: #f46d97;
}
.step-4 {
    background-color: #f8a468;
}
.step-icon-wrapper {
    width: 84px;
    height: 84px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 30px;
    transition: transform 0.3s ease;
}
.data-sources-box {
    border: 1px solid #e9ecef;
    border-radius: 12px;
    padding: 16px 24px;
    margin-top: 30px;
    display: flex;
    align-items: center;
    justify-content: space-around;
    flex-wrap: wrap;
    background-color: #ffffff;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
}
.ds-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.85rem;
    color: #6c757d;
    font-weight: 500;
}
.ds-item img {
    height: 24px;
    width: auto;
}
</style>