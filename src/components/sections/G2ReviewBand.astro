---
interface Badge { src: string; alt: string; title?: string; width?: number; height?: number }
interface Review { text: string; rating: string; ratingAlt?: string; reviewer: string }
interface Props {
  headline: string
  anchor?: string
  badgesLeft?: Badge[]
  centerBadge?: Badge
  badgesRight?: Badge[]
  reviews?: Review[]
  calloutIcon?: string
  calloutText?: string
  calloutCtaLabel?: string
  calloutCtaHref?: string
}

const {
  headline,
  anchor = 'reviews',
  badgesLeft = [],
  centerBadge,
  badgesRight = [],
  reviews = [],
  calloutIcon,
  calloutText,
  calloutCtaLabel,
  calloutCtaHref,
} = Astro.props
---

<section id={anchor} class="bg-light pt-5">
<div class="container mb-5"><header class="row">
<div class="col-md-12 text-center mb-0">
<h2 set:html={headline}></h2>
</div>
</header>
<div class="container bq--openquote">
<div class="row mr-auto ml-auto mt-5 text-center">
<div class="col-12">
	<div class="d-flex d-flex-container justify-content-center align-items-center flex-column flex-md-row">
		<div class="order-1 d-flex">
{badgesLeft.map((b: Badge) => (
<img decoding="async" class="b-lazy px-2" src={b.src} alt={b.alt} title={b.title ?? b.alt} width={b.width ?? 90} height={b.height ?? 115}>
))}<p></p>
		</div>
		<div class="order-0 order-md-1">
			{centerBadge && (
			<img decoding="async" class="b-lazy" src={centerBadge.src} alt={centerBadge.alt} title={centerBadge.title ?? centerBadge.alt} width={centerBadge.width ?? 125} height={centerBadge.height ?? 162}>
			)}
		</div>
		<div class="order-1 d-flex">
			{badgesRight.map((b: Badge) => (
			<img decoding="async" class="b-lazy px-2" src={b.src} alt={b.alt} title={b.title ?? b.alt} width={b.width ?? 90} height={b.height ?? 115}>
			))}
		</div>
	</div>
</div>
</div>
<div class="row mr-auto ml-auto mt-5">
{reviews.map((r: Review) => (
<div class="col-lg-4 pl-md-5 pr-md-5 pl-sm-3 pr-sm-3 animate-me" data-animation="fadeInLeft">
<blockquote>
<p class="mt-3" set:html={r.text}></p>
<img decoding="async" class="mb-3 b-lazy" width="100" height="18" src={r.rating} alt={r.ratingAlt ?? 'g2'} title={r.ratingAlt ?? 'g2'}>
<footer set:html={r.reviewer}></footer>
</blockquote>
</div>
))}
</div>
</div>
<div class="row align-items-center text-center mx-auto no-gutters mt-4" style="max-width: 1000px;">
<div class="col-xl-2 mt-3 mb-3 pr-4 text-xl-right"><img decoding="async" class="b-lazy" src={calloutIcon} width="50" height="50" alt="g2" title="g2"></div>
<div class="col-xl-6">
<p class="mb-0" set:html={calloutText}></p>
</div>
<div class="col-xl-3"><a class="btn btn-outline-primary m-3 mchNoDecorate" rel="noopener noreferrer" href={calloutCtaHref} target="_blank">{calloutCtaLabel}</a></div>
</div>
</div>
</section>
