---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import DarkHero from '../../components/sections/DarkHero.astro'
const allEvents = await getCollection('events')
const events = allEvents.filter((event) => event.id.startsWith('en/'))
const now = new Date()
const upcoming = events
  .filter((event) => new Date(`${event.data.date}T23:59:59`) >= now)
  .sort((a, b) => a.data.date.localeCompare(b.data.date))

const past = events
  .filter((event) => new Date(`${event.data.date}T23:59:59`) < now)
  .sort((a, b) => b.data.date.localeCompare(a.data.date))

const formatDate = (isoDate: string) =>
  new Date(`${isoDate}T12:00:00`).toLocaleDateString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  })
---

<BaseLayout title="Events | Reveal" description="Upcoming and past Reveal events.">
  <DarkHero
    title="Events"
    breadcrumbs={[{ label: 'Home', url: '/' }, { label: 'Events' }]}
  />

  <div class="container py-5">
    <section>
      <h2 class="mb-4">Upcoming Events</h2>

      {upcoming.length > 0 ? (
        <div class="row">
          {upcoming.map((event) => (
            <div class="col-12 col-lg-8 mb-4">
              <article class="card shadow-sm h-100">
                <div class="card-body d-flex flex-column">
                  <h3 class="h4 card-title mb-2">{event.data.title}</h3>
                  <p class="text-muted mb-1">{formatDate(event.data.date)}</p>
                  <p class="text-muted mb-3">{event.data.location}</p>
                  <p class="card-text mb-4">{event.data.summary ?? event.data.description}</p>
                  <div class="mt-auto">
                    <a class="btn btn-primary" href={`/events/${event.id.replace(/^en\//, '')}`}>View Event</a>
                  </div>
                </div>
              </article>
            </div>
          ))}
        </div>
      ) : (
        <p class="text-muted">There are no upcoming events.</p>
      )}
    </section>

    <section class="pt-3">
      <h2 class="mb-4">Past Events</h2>
      {past.length > 0 ? (
        <ul class="list-unstyled">
          {past.map((event) => (
            <li class="mb-3 pb-3 border-bottom">
              <a href={`/events/${event.id.replace(/^en\//, '')}`} class="font-weight-bold">{event.data.title}</a>
              <div class="text-muted small">{formatDate(event.data.date)} - {event.data.location}</div>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-muted">There are no events for this topic.</p>
      )}
    </section>
  </div>
</BaseLayout>