---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'

export async function getStaticPaths() {
  const events = await getCollection('events')
  return events
    .filter((event) => event.id.startsWith('en/'))
    .map((event) => ({
      params: { slug: event.id.replace(/^en\//, '') },
      props: { event },
    }))
}

const { event } = Astro.props
const { Content } = await render(event)
const formName = event.data.title
const eventDetailParam = event.data.title

function ordinalDate(isoDate: string) {
  const d = new Date(`${isoDate}T12:00:00`)
  const day = d.getDate()
  const suffix = ['th','st','nd','rd'][((day % 100) > 10 && (day % 100) < 14) ? 0 : Math.min(day % 10, 4)] || 'th'
  return d.toLocaleDateString('en-US', { month: 'long', year: 'numeric' }).replace(/\d{4}/, `${day}${suffix}, $&`).replace(/,\s*,/, ',')
}
---

<BaseLayout title={`${event.data.title} | Reveal Embedded Analytics`} description={event.data.description}>
  <div class="events-page-wrapper">
    <style>
      .white-nav-background { background: rgba(255,255,255,0.9); }

      .event-breadcrumb {
        display: flex;
        flex-wrap: wrap;
        gap: .5rem;
        margin-bottom: 1.1rem;
        font-size: .8rem;
        font-weight: 500;
      }
      .event-breadcrumb a,
      .event-breadcrumb span { color: rgba(255,255,255,.9); }
      .event-breadcrumb__sep { opacity: .75; }

      .event-meta-bar {
        display: inline-flex;
        flex-wrap: wrap;
        align-items: stretch;
        gap: 0;
        margin-bottom: 2rem;
        padding: 0;
        list-style: none;
        border: 1px solid rgba(255,255,255,.28);
        border-radius: .45rem;
        overflow: hidden;
        background: rgba(255,255,255,.07);
      }
      .meta-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.6rem 0.7rem;
        font-size: 0.72rem;
        font-weight: 600;
        line-height: 1;
        white-space: nowrap;
      }
      .meta-badge:not(:last-child) { border-right: 1px solid rgba(255,255,255,.22); }
      .event-meta-badge__icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.1rem;
        height: 1.1rem;
        margin-right: .6rem;
        opacity: .95;
        flex: 0 0 auto;
      }
      .event-meta-badge__icon svg,
      .event-meta-badge__icon img { width: 100%; height: 100%; }
      .event-meta-badge__icon img { object-fit: contain; }
      .event-meta-badge__icon svg { fill: currentColor; }

      .event-form-card {
        position: sticky;
        top: 94px;
        align-self: start;
        z-index: 4;
        color: #20253a;
        margin-top: 0;
      }

      .event-hero {
        position: relative;
        padding: 1.35rem 0 3.1rem;
        overflow: hidden;
        min-height: 51rem;
        background: linear-gradient(135deg, #ea3e7f 0%, #ef4a7e 58%, #f36a83 100%);
      }
      .event-hero__row { align-items: start; }
      .event-hero__copy { padding-top: .55rem; }
      .event-hero .entry-title {
        max-width: 10.5ch;
        margin-bottom: 1rem;
        font-size: clamp(2.55rem, 4.6vw, 4rem);
        line-height: .98;
        letter-spacing: -.05em;
      }

      .event-page__body {
        position: relative;
        margin-top: -25rem;
        padding-top: 3rem;
        background: #fff;
      }
      .event-page__row { align-items: start; }
      .content-shell {
        position: relative;
        z-index: 3;
        padding-top: 2rem;
      }

      .event-hero-note {
        margin-top: 1.5rem;
        padding: 1rem 1.25rem 1rem 1.1rem;
        border-left: 4px solid rgba(255,255,255,.95);
        border-radius: .35rem;
        background: rgba(255,255,255,.13);
        color: rgba(255,255,255,.92);
        font-size: .9rem;
        font-style: italic;
        line-height: 1.6;
        box-shadow: inset 0 1px 0 rgba(255,255,255,.08);
      }

      .event-form-card [data-form="main"] {
        max-width: 21rem;
        border-radius: .5rem;
        background: rgba(255,255,255,.98);
        box-shadow: 0 20px 60px rgba(36,32,75,0.18);
        transform: translateY(2.25rem);
      }
      .event-form-card [data-form="fields"] {
        padding: 1.5rem 1.35rem 1.1rem;
      }
      .event-form-card .lead-tracker-form { display: block; }
      .event-form-card .ui-form__required-note,
      .event-form-card .lead-tracker-form__footer-note {
        font-size: .78rem;
        line-height: 1.5;
      }
      .event-form-card .custom-control { margin-right: 0; }
      .event-form-card .custom-control-label { font-size: .76rem; line-height: 1.5; }
      .event-form-card .lead-tracker-form__footer-note {
        margin: .75rem 0 0;
        color: #8a90a6;
        font-style: italic;
        text-align: center;
      }
      .event-form-card input.required + label::after,
      .event-form-card select.required + label::after,
      .event-form-card textarea.required + label::after { content: '*'; }

      .event-form-card .lead-tracker-choice-group { margin-top: 1.2rem; }
      .event-form-card .lead-tracker-choice-group__legend {
        display: block;
        margin-bottom: .7rem;
        color: #3d4359;
        font-size: .85rem;
        font-weight: 600;
        line-height: 1.5;
      }
      .event-form-card .lead-tracker-choice-group__legend--required::after { content: '*'; }
      .event-form-card .lead-tracker-choice-group__options {
        display: flex;
        flex-wrap: wrap;
        gap: .6rem 1rem;
      }
      .event-form-card .lead-tracker-choice-group--stacked .lead-tracker-choice-group__options {
        display: grid;
        gap: .55rem;
      }
      .event-form-card .lead-tracker-choice-group .custom-control {
        min-height: 1.4rem;
        padding-left: 1.6rem;
      }
      .event-form-card .lead-tracker-choice-group .custom-control-label {
        color: #59607a;
        font-size: .82rem;
        line-height: 1.45;
      }
      .event-form-card .custom-control-inline + .custom-control-inline { margin-left: 0; }

      .event-form-card .leadtracker-radio-group {
        margin-top: 1.2rem;
        padding-bottom: 1rem;
        margin-bottom: 1rem;
        border-bottom: 1px solid #e5e8f0;
        display: flex;
        flex-direction: column;
      }
      .event-form-card .leadtracker-radio-group > .leadtracker-radio-group__label {
        order: 1;
        margin-bottom: .55rem;
        font-size: .76rem;
        font-weight: 400;
        line-height: 1.5;
      }
      .event-form-card .leadtracker-radio-group > .leadtracker-radio-group__label::after {
        content: '*';
        margin-left: .2rem;
      }
      .event-form-card .leadtracker-radio-group > div {
        order: 2;
        display: flex;
        flex-wrap: wrap;
        gap: .45rem 1.15rem;
      }
      .event-form-card .leadtracker-radio-group .custom-control.custom-radio.custom-control-inline {
        display: inline-flex;
        flex-direction: row-reverse;
        align-items: center;
        gap: .42rem;
        width: auto;
        min-height: 1.35rem;
        margin: 0;
        padding-left: 0;
      }
      .event-form-card .leadtracker-radio-group .custom-control-input {
        position: static;
        width: 1rem;
        height: 1rem;
        margin: 0;
        opacity: 1 !important;
        z-index: 1;
      }
      .event-form-card .leadtracker-radio-group .custom-control-label {
        position: static;
        padding-left: 0;
        font-size: .82rem;
        color: #59607a;
        line-height: 1.4;
      }
      .event-form-card .leadtracker-radio-group .custom-control-label::before,
      .event-form-card .leadtracker-radio-group .custom-control-label::after { display: none; }
      .event-form-card .leadtracker-radio-group[data-radio-group-name="deep_dive_session"] {
        border-bottom: 0;
        padding-bottom: 0;
        margin-bottom: 1.2rem;
      }
      .event-form-card .leadtracker-radio-group[data-radio-group-name="deep_dive_session"] > div {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: .55rem;
      }
      .event-form-card .leadtracker-radio-group[data-radio-group-name="deep_dive_session"] .custom-control.custom-radio.custom-control-inline {
        display: inline-flex;
        width: auto;
      }

      .event-form-card .btn,
      .event-form-card button[type="submit"],
      .event-form-card input[type="submit"] {
        min-height: 2.85rem;
        border-radius: 999px;
        width: 100%;
      }
      .event-form-card .custom-control.custom-checkbox.custom-control-inline { width: 100%; }
      .event-form-card .submit.btn {
        margin-top: .35rem;
        font-size: .95rem;
        letter-spacing: .01em;
      }

      :global(.section) { padding: 3.75rem 0; }
      :global(.section--tight) { padding-top: 2.75rem; padding-bottom: 2.75rem; }
      :global(.section-kicker), :global(.cluster-label) {
        margin: 0 0 .75rem;
        font-size: .78rem;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
      }
      :global(.section-kicker) { color: #ea3e7f; }
      :global(.cluster-label) { margin-top: 1.5rem; color: #7a819b; }
      :global(.section-title) {
        margin: 0;
        color: #20253a;
        font-size: clamp(2rem, 3vw, 3rem);
        line-height: 1.08;
        letter-spacing: -.05em;
        font-weight: 800;
      }

      :global(.agenda) { margin-top: 2.15rem; position: relative; }
      :global(.agenda)::before {
        content: "";
        position: absolute;
        left: .72rem;
        top: .15rem;
        bottom: 1rem;
        width: 2px;
        background: linear-gradient(180deg, rgba(87,116,228,.08) 0%, rgba(87,116,228,.24) 20%, rgba(87,116,228,.08) 100%);
      }
      :global(.agenda-item) { position: relative; margin-bottom: 2.1rem; padding-left: 3rem; }
      :global(.agenda-item)::before {
        content: "";
        position: absolute;
        left: calc(.72rem - .4rem);
        top: .43rem;
        width: .8rem;
        height: .8rem;
        border-radius: 999px;
        background: #4f6fe6;
        border: 0;
      }
      :global(.agenda-time) { display: inline-block; margin-bottom: .45rem; color: #4f6fe6; font-size: .82rem; font-weight: 800; }
      :global(.agenda-title) { line-height: 1.18; }

      :global(.tag-row), :global(.chip-row) { display: flex; flex-wrap: wrap; gap: .75rem .9rem; margin-top: .9rem; }
      :global(.tag), :global(.chip) { display: inline-flex; align-items: center; border-radius: 999px; font-weight: 700; }
      :global(.tag) {
        min-height: 1.75rem; padding: 0 .8rem;
        background: #f2f5ff; color: #5e7fee;
        border: 1px solid #edf1ff; font-size: .74rem;
        box-shadow: inset 0 1px 0 rgba(255,255,255,.85);
      }
      :global(.chip) {
        min-height: 2.45rem; padding: 0 1.1rem;
        background: linear-gradient(180deg, #f7f9ff 0%, #eef3ff 100%);
        border: 1px solid #edf2ff; color: #4d7ae6;
        font-size: .92rem; font-weight: 800; letter-spacing: -.01em; line-height: 1.2;
        box-shadow: inset 0 1px 0 rgba(255,255,255,.9), 0 1px 2px rgba(46,74,156,.06);
      }

      :global(.optional-note) { margin-top: .25rem; padding-left: 3rem; font-size: .92rem; font-style: italic; }

      .card-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.125rem;
        margin-top: 1.75rem;
      }

      @media (max-width: 1199px) { .event-hero { min-height: 58rem; } }
      @media (max-width: 991px) {
        .event-form-card { position: static; margin-top: 0; }
        .event-hero { padding-bottom: 2.5rem; }
        .event-page__body { margin-top: 0; padding-top: 2.5rem; }
        .content-shell { padding: 0; }
        .card-grid { grid-template-columns: 1fr; }
        :global(.section) { padding-top: 3.5rem; padding-bottom: 3.5rem; }
        :global(.agenda)::before { left: .5rem; }
        :global(.agenda-item), :global(.optional-note) { padding-left: 2.125rem; }
        :global(.agenda-item)::before { left: 0; }
        .event-meta-bar { display: flex; }
        .event-form-card [data-form="main"] { max-width: none; transform: none; }
        .meta-badge { width: 100%; border-right: 0; }
        .meta-badge:not(:last-child) { border-right: 0; border-bottom: 1px solid rgba(255,255,255,.22); }
      }
    </style>

    <section class="event-hero">
      <div class="container">
        <div class="row event-hero__row">
          <div class="col-12 col-lg-7 text-light text-white event-hero__copy">
            <div class="event-hero__copy-inner">
              <nav class="event-breadcrumb" aria-label="Breadcrumb">
                <a href="/">Home</a>
                <span class="event-breadcrumb__sep">/</span>
                <a href="/events">Events</a>
                <span class="event-breadcrumb__sep">/</span>
                <span>{event.data.title}</span>
              </nav>

              <ul class="event-meta-bar" aria-label="Event details">
                {event.data.location && (
                  <li class="meta-badge">
                    <span class="event-meta-badge__icon" aria-hidden="true">
                      <img src="https://static.infragistics.com/marketing/reveal/icons/icon-location.svg" alt="" />
                    </span>
                    {event.data.location}
                  </li>
                )}
                <li class="meta-badge">
                  <span class="event-meta-badge__icon" aria-hidden="true">
                    <img src="https://static.infragistics.com/marketing/reveal/icons/icon-calendar.svg" alt="" />
                  </span>
                  {ordinalDate(event.data.date)}
                </li>
                {event.data.time && (
                  <li class="meta-badge">
                    <span class="event-meta-badge__icon" aria-hidden="true">
                      <img src="https://static.infragistics.com/marketing/reveal/icons/icon-clock.svg" alt="" />
                    </span>
                    {event.data.time}
                  </li>
                )}
                {event.data.seats && (
                  <li class="meta-badge">
                    <span class="event-meta-badge__icon" aria-hidden="true">
                      <img src="https://static.infragistics.com/marketing/reveal/icons/icon-multi-user.svg" alt="" />
                    </span>
                    {event.data.seats}
                  </li>
                )}
              </ul>

              {event.data.tagline && <p class="font-weight-bold mb-2">{event.data.tagline}</p>}
              <h1>{event.data.title}</h1>

              {event.data.summary && (
                <div class="mb-5">
                  <p>{event.data.summary}</p>
                  {event.data.heroNote && (
                    <div class="event-hero-note">{event.data.heroNote}</div>
                  )}
                </div>
              )}
            </div>
          </div>

          <aside class="col-12 col-lg-5 event-form-card pt-4 pt-lg-0 order-0 order-lg-1 mb-4 mb-lg-0 color-dark" id="claim-spot">
            <span class="d-block">
              <div data-form="main" class="shadow overflow-hidden rounded-xl" id="event__register-form">
                <div data-form="fields" class="text-left rounded-0 border-top-0 mb-0 bg-white">
                  <header class="text-left mb-2">
                    <h3 class="mb-1 font-weight-bold">Claim Your Spot</h3>
                    <p class="text-0875 text-muted mb-2"><em>Limited to 15 senior product &amp; engineering leaders. Don't miss out!</em></p>
                  </header>

                  <form id="lead-form_1" class="lead-tracker-form ui-form" data-form-theme="">
                    <div id="apiError1" class="apiError field-validation-error-msg" style="display:none;">
                      Sorry, it seems that we have run into an issue with the form.
                      <a href="#" onclick="location.reload();return false;" style="color:red;text-decoration:underline;font-weight:bold;">Please try again</a>
                      in a few minutes. If you still experience issues, please contact us at
                      <a href="mailto:support@revealbi.io" style="color:red;text-decoration:underline;font-weight:bold;">support@revealbi.io</a>.
                    </div>
                    <div class="form-row">
                      <div class="col-12"><span class="ui-form__required-note">Required</span></div>
                      <div id="recaptchaError1" class="recaptchaError field-validation-error-msg" style="display:none;">Unfortunately, Google has considered you a bot. Please contact <a href="mailto:support@revealbi.io" style="color:red;text-decoration:underline;font-weight:bold;">support@revealbi.io</a>.</div>
                      <div id="formInvalidConditionForm1" class="formInvalidConditionForm field-validation-error-msg" style="display:none;">Please accept the form terms to submit successfully.</div>
                      <div id="formInvalidEmail1" class="formInvalidEmail field-validation-error-msg" style="display:none;">This email address doesn't appear valid. Please update and try again.</div>
                      <div id="formInvalidFreeEmail1" class="formInvalidFreeEmail field-validation-error-msg" style="display:none;">Please use a business email address.</div>
                    </div>

                    <div class="form-row">
                      <div class="col-12">
                        <div class="form-row d-none">
                          <div class="form-group col">
                            <input id="Country_1" name="Country" class="sfInput form-control" type="text" value="" tabindex="-1" autocomplete="false" />
                            <label for="Country_1">Country</label>
                          </div>
                        </div>

                        <div class="form-row">
                          <div class="form-group col">
                            <input id="Email_1" name="Email" type="email" class="form-control sfInput required" data-val-length-max="60" data-val-length="Email cannot exceed 60 characters." value="" />
                            <label for="Email_1">Business Email</label>
                          </div>
                        </div>

                        <div class="form-row name">
                          <div class="form-group col-12 col-sm-6">
                            <input id="FirstName_1" name="FirstName" type="text" class="form-control sfInput required" data-val-length-max="100" data-val-length="First Name cannot exceed 100 characters." value="" />
                            <label for="FirstName_1">First Name</label>
                          </div>
                          <div class="form-group col-12 col-sm-6">
                            <input id="LastName_1" name="LastName" type="text" class="form-control sfInput required" data-val-length-max="100" data-val-length="Last Name cannot exceed 100 characters." value="" />
                            <label for="LastName_1">Last Name</label>
                          </div>
                        </div>

                        <div class="form-row">
                          <div class="form-group col-12 col-sm-6">
                            <input id="Company_1" name="Company" type="text" class="form-control sfInput required" data-val-length-min="2" data-val-length-max="50" data-val-length="Company name must be between 2 and 50 characters." value="" />
                            <label for="Company_1">Company</label>
                          </div>
                          <div class="form-group col-12 col-sm-6">
                            <input id="Title_1" name="Title" type="text" class="form-control sfInput required" data-val-length-min="2" data-val-length-max="50" data-val-length="Job title must be between 2 and 50 characters." value="" aria-required="true" />
                            <label for="Title_1">Job Title</label>
                          </div>
                        </div>

                        <div class="form-row">
                          <div class="form-group col leadtracker-radio-group" data-radio-group-name="deep_dive_session">
                            <div>
                              <div class="custom-control custom-radio custom-control-inline">
                                <input name="deep_dive_session" type="radio" class="custom-control-input" id="radio_deep_0" value="Yes - onsite 12:30-2:00 PM" aria-required="true" />
                                <label class="custom-control-label" for="radio_deep_0">Yes - onsite 12:30-2:00 PM</label>
                              </div>
                              <div class="custom-control custom-radio custom-control-inline">
                                <input name="deep_dive_session" type="radio" class="custom-control-input" id="radio_deep_1" value="Yes - schedule later" aria-required="true" />
                                <label class="custom-control-label" for="radio_deep_1">Yes - schedule later</label>
                              </div>
                              <div class="custom-control custom-radio custom-control-inline">
                                <input name="deep_dive_session" type="radio" class="custom-control-input" id="radio_deep_2" value="Not sure yet" aria-required="true" />
                                <label class="custom-control-label" for="radio_deep_2">Not sure yet</label>
                              </div>
                            </div>
                            <span class="leadtracker-radio-group__label">Would you be interested in a technical deep dive session after the event?</span>
                          </div>
                        </div>

                        <div class="form-row">
                          <div class="form-group col leadtracker-radio-group" data-radio-group-name="happy_hour_networking">
                            <div>
                              <div class="custom-control custom-radio custom-control-inline">
                                <input name="happy_hour_networking" type="radio" class="custom-control-input" id="radio_happy_0" value="Yes" aria-required="true" />
                                <label class="custom-control-label" for="radio_happy_0">Yes</label>
                              </div>
                              <div class="custom-control custom-radio custom-control-inline">
                                <input name="happy_hour_networking" type="radio" class="custom-control-input" id="radio_happy_1" value="No" aria-required="true" />
                                <label class="custom-control-label" for="radio_happy_1">No</label>
                              </div>
                              <div class="custom-control custom-radio custom-control-inline">
                                <input name="happy_hour_networking" type="radio" class="custom-control-input" id="radio_happy_2" value="Maybe" aria-required="true" />
                                <label class="custom-control-label" for="radio_happy_2">Maybe</label>
                              </div>
                            </div>
                            <span class="leadtracker-radio-group__label">Will you join the optional happy hour / networking?</span>
                          </div>
                        </div>

                        <div class="form-row">
                          <div class="form-group col">
                            <div class="custom-control custom-checkbox custom-control-inline">
                              <input name="acceptGDPRFormSubmission" id="acceptGDPRFormSubmission_1" type="checkbox" class="accept-gdpr custom-control-input" value="yes" aria-required="true" />
                              <label for="acceptGDPRFormSubmission_1" class="custom-control-label">
                                I understand and agree to the terms of Infragistics&apos;
                                <a class="text-decoration-none font-weight-bolder" href="/terms-of-use">Terms of Use</a>
                                and
                                <a class="text-decoration-none font-weight-bolder" href="/privacy-policy">Privacy Policy</a>
                                <p class="mt-2 mb-0 label">This site is protected by reCAPTCHA and the Google Privacy Policy and Terms of Use apply.</p>
                              </label>
                            </div>
                          </div>
                        </div>
                      </div>

                      <div class="col-12">
                        <div class="form-row justify-content-center">
                          <div class="col col-lg text-center">
                            <button id="submit_1" type="submit" class="submit btn rounded-pill btn-primary" disabled>CLAIM YOUR SPOT</button>
                          </div>
