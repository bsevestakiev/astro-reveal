                      </div>
                    </div>
                  </form>

                  <div class="thankyou__container thankyou__lead-form_1" style="display:none;">
                    <div class="features-hero__form-message text-center" style="width:100%;">
                      <h2 class="pb-4">Thank you!</h2>
                      <p>Your information has been submitted.</p>
                    </div>
                  </div>
                </div>
              </div>
            </span>
          </aside>
        </div>
      </div>
    </section>

    <section class="event-page__body" id="event-content">
      <div class="container">
        <div class="row event-page__row">
          <div class="col-12 col-lg-7">
            <div class="content-shell">
              <Content />
            </div>
          </div>
        </div>
      </div>
    </section>

    <script is:inline>
      window.addEventListener('DOMContentLoaded', function () {
        const shell = document.querySelector('.content-shell')
        if (!shell) return

        const h2s = Array.from(shell.querySelectorAll('h2'))
        h2s.forEach((h2) => {
          const text = (h2.textContent || '').trim()
          const normalized = text.replace(/[’']/g, "'")
          if (normalized === "What You'll Walk Away With") {
            h2.classList.add('section-title', 'mb-3')
          } else if (text === 'Deep Dive Session') {
            // Keep native heading spacing for this section to match live page.
          } else if (text) {
            h2.classList.add('mb-3')
          }

          const next = h2.nextElementSibling
          if (text === 'Designed For Teams Shipping Real Products' && next && next.tagName === 'P') {
            next.classList.add('section-intro')
          }

          if (text === 'Designed For Teams Shipping Real Products') {
            const parent = h2.closest('.container')
            if (parent) parent.classList.add('audience')
          }
        })

        // Recreate live section boundaries around major content blocks.
        const directH2s = Array.from(shell.children).filter((node) => node.tagName === 'H2')
        const sectionMap = {
          'Why This Event': { className: 'section section--tight' },
          'A Half-Day Built For Outcomes, Not Slide Decks': { id: 'agenda' },
          "What You'll Walk Away With": { className: 'section section--tight' },
          'Designed For Teams Shipping Real Products': { className: '' },
          'Deep Dive Session': { className: 'section section--tight' },
        }

        directH2s.forEach((heading) => {
          const raw = (heading.textContent || '').trim()
          const text = raw.replace(/[’']/g, "'")
          const cfg = sectionMap[text]
          if (!cfg) return
          if (heading.parentElement !== shell) return

          const wrapper = document.createElement('section')
          if (cfg.className) wrapper.className = cfg.className
          if (cfg.id) wrapper.id = cfg.id

          const siblings = Array.from(shell.children)
          const start = siblings.indexOf(heading)
          let end = siblings.length
          for (let i = start + 1; i < siblings.length; i += 1) {
            if (siblings[i].tagName === 'H2') {
              end = i
              break
            }
          }

          shell.insertBefore(wrapper, heading)
          for (let i = start; i < end; i += 1) {
            wrapper.appendChild(siblings[i])
          }
        })

      })
    </script>

    <script is:inline define:vars={{ formName, eventDetailParam }}>
      window.addEventListener('load', function () {
        if (typeof leadTracker === 'undefined') return;
        if (!document.getElementById('lead-form_1')) return;
        var cfg = window.__REVEAL_CONFIG__ || {};
        leadTracker.execute({
          macro: 'LeadTracker',
          lang: 'en',
          leadFormID: 'lead-form_1',
          reaptchaKey: cfg.recaptchaSiteKey || '6Lc-MFAaAAAAAIWi7UOrSUfUZnVmDUSsXjzS4BgY',
          redirectUrl: '',
          redirectMode: '_self',
          thankYouMessage: '1',
          formContainerId: '',
          productCode: 'A8',
          leadProductCode: '',
          packageName: '',
          productResourceType: '',
          osSupport: '',
          installerType: '',
          eventTypeParam: 'live event',
          eventDetailParam: eventDetailParam,
          prohibitFreeMail: true,
          prohibitDisposableMail: true,
          showRequestDemo: false,
          googleEventType: 'Event - Register',
          googleEventLabel: eventDetailParam,
          googleEventTypeDownload: '',
          googleEventLabelDownload: '',
          zoomWebinarId: '',
          leadSourceNumber: 'A800012',
          tier: 'tier_2',
          formLocation: '',
          formValue: '1000',
          productName: 'Reveal',
          formName: formName,
          cookiesPrefix: 'reveal_',
        });
      });
    </script>
  </div>
