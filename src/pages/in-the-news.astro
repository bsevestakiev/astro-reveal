<BaseLayout
  title="In The News | Reveal Embedded Analytics"
  description="Reveal Embedded Analytics in the press - read the latest articles, coverage, and press mentions from leading publications."
>

  <style is:global>
    .bg-newsroom {
      background:
        url('https://static.infragistics.com/marketing/reveal/business-teams-reveal-hero-teardrop-new.svg'),
        linear-gradient(90deg, rgba(251,179,101,1) 0%, rgba(236,65,122,1) 40%);
      background-repeat: no-repeat;
      background-position: top center, top;
      background-size: 1750px 540px, auto;
    }

    .bg-newsroom-bot {
      overflow: visible;
      padding-bottom: 5rem;
    }

    .newsroom-logo-band {
      z-index: 2;
      bottom: -25%;
    }

    .newsroom-press-card .card-text p {
      line-height: 1.5;
      margin-bottom: 0;
    }

    .newsroom-press-card a.mt-auto {
      font-weight: 700;
      color: #2b46bb;
      text-decoration: none;
    }
  </style>

  <div class="bg-gradient--primary position-relative bg-newsroom bg-newsroom-bot mb-5">
    <div class="position-relative bg-transparent pt-4 pb-3" style="z-index:3;">
      <div class="container">
        <div class="row pb-3 pb-md-4">
          <div class="col-12 col-sm-8 mt-md-2 text-center text-white pb-0 pb-md-3 mx-auto">
            <h1 class="text-h2 text-white">Newsroom</h1>
            <p class="mb-4 mw-950px mx-auto">Stay updated with the latest press releases, press coverage, product news, and interviews from around the web, including insights on the benefits of embedded analytics.</p>
          </div>
        </div>
      </div>
    </div>

    <div class="container-fluid clearfix px-0 position-absolute overflow-hidden newsroom-logo-band">
      <div class="loader__container spinner__container" style="min-height: 200px;">
        <div class="spinner spinner--border"></div>
      </div>
      <div id="main-tns-container" class="float-left" style="display:none;">
        <div class="row align-items-center">
          <div class="col-12 py-3 text-center tns-slider--regular tns-slider--transition-timing__linear"
               data-items="6" data-autoplaydirection="backward" data-loop="true" data-autoplay="true"
               data-autoplayhoverpause="false" data-autoplaybuttonoutput="false" data-controls="false"
               data-nav="false" data-speed="3300" data-autoplaytimeout="0" data-preventactionwhenrunning="true"
               data-mousedrag="false" data-fixedwidth="120" data-gutter="0" data-nested="inner">
            {pressLogos.map((logo) => (
              <div class="slide shadow rounded-circle p-3 mx-3 bg-white">
                <img loading="lazy" decoding="async" width="150" height="150" src={logo.src} alt={logo.alt} title={logo.title} />
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>

  <div id="in-the-news" class="container pt-5 pb-3">
    <div class="row text-center pt-3">
      <div class="col-12">
        <h2>Reveal in the Press</h2>
      </div>
    </div>
  </div>

  <div class="container mb-5">
    <div class="wrapper">
      <div class="row row-eq-height">
        {pressArticles.map((article) => (
          <div class="col-12 col-md-4 mb-4 px-3">
            <article class="card h-100 d-flex flex-column p-4-5 newsroom-press-card">
              <header>
                <div class="p-0 h-40px">
                  <img loading="lazy" decoding="async" class="h-100 w-auto" src={article.logo} alt={article.logoAlt} />
                </div>
                <h3 class="card-title h4 pt-4 text-dark font-weight-bold">{article.title}</h3>
              </header>
              <div class="card-text">
                <p>{article.excerpt}</p>
              </div>
              <a target="_blank" class="mt-auto" rel="noopener" href={article.href}>Read Article</a>
            </article>
          </div>
        ))}
      </div>
      <nav class="navigation pagination" role="navigation" aria-label="Pagination Navigation Aria Label">
        <div class="nav-links"></div>
      </nav>
    </div>
  </div>

  <div class="container">
    <div class="row text-center my-5 py-5">
      <div class="col-12">
        <h2>Press Inquiries</h2>
      </div>
      <div class="col-12 mt-2 mb-3">
        <p class="mx-auto mw-950px">For media inquiries, press releases, or interview requests, please <a href="/about-us#request-demo">contact us</a>.</p>
      </div>
    </div>
  </div>

</BaseLayout>
