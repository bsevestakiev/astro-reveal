---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'

export async function getStaticPaths() {
  const stories = await getCollection('stories')
  return stories
    .filter(s => s.id.startsWith('en/'))
    .map(story => ({
      params: { slug: story.id.replace(/^en\//, '') },
      props: { story },
    }))
}

const { story } = Astro.props
const { Content } = await render(story)

const titleOverrides: Record<string, string> = {
  'synergy-logistics-elevating-warehouse-visibility-and-operational-intelligence-with-reveal': 'Elevating Warehouse Visibility and Operational Intelligence with Reveal',
  'commodity-centre': 'Commodity Centre - Elevating Real Time Visualization of Warehouse Data With Reveal',
  'lanxing-drives-data-driven-decision-making-in-the-supply-chain-with-reveal': 'Lanxing Drives Data-driven Decision Making in the Supply Chain with Reveal',
  'scriptly-helps-pharmacies-identify-trends-in-real-time-with-reveal': 'Scriptly Helps Pharmacies Identify Trends in Real Time with Reveal',
  'datacom-case-study': 'Reveal Brings Multiple Data Points into a Single Pane of Glass',
  'overwhelming-data-easy-to-digest-and-use-for-decision-making-with-reveal': 'Overwhelming Data: Easy to Digest and Use For Decision Making With Reveal',
  'avion': 'Avion Saves a Year of Development Time with Reveal Embedded Analytics Software',
  'sensato': 'Sensato Accelerates Time-to-Market by 10x',
  'casebook': 'Social Services Agencies Leave Paper and Excel Spreadsheets Behind',
  'atanasoft': 'Atanasoft Customers Visualize Complex Data in Ways Never Before Possible',
}

const slug = story.id.replace(/^en\//, '')
const displayTitle = titleOverrides[slug] ?? story.data.title

const splitList = (value?: string | string[]) => {
  if (!value) return []
  if (Array.isArray(value)) return value.filter(Boolean)
  return value
    .split(',')
    .map((v) => v.trim())
    .filter(Boolean)
}

const industryItems = splitList(story.data.industry)
const marketsItems = splitList(story.data.marketsServed)
const challengeItems = splitList(story.data.topChallenges)
const whyItems = splitList(story.data.whyReveal)
---

<BaseLayout
  title={`${displayTitle} | Reveal Customer Story`}
  description={story.data.description}
  image={story.data.cover}
>
  <header class="story-header py-5">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-12 col-lg-6 mb-4 mb-lg-0">
          {story.data.logo && (
            <img
              src={story.data.logo}
              alt={`${displayTitle} logo`}
              class="customer-stories__logo customer-stories_logo"
              loading="lazy"
              decoding="async"
            />
          )}
          <h1 class="story-header__title">{displayTitle}</h1>
        </div>

        {story.data.cover && (
          <div class="col-12 col-lg-6 text-sm-left text-md-center text-lg-right">
            <img
              src={story.data.cover}
              alt={displayTitle}
              class="story-header__image img-fluid"
              loading="lazy"
              decoding="async"
            />
          </div>
        )}
      </div>
    </div>
  </header>

  <div class="container py-5 story-page">
    <div class="row align-items-start">
      <div class="col-12 col-lg-8 order-2 order-lg-1">
        <article class="entry-content story-body">
          <Content />
        </article>
      </div>

      {(industryItems.length > 0 || marketsItems.length > 0 || challengeItems.length > 0 || whyItems.length > 0) && (
        <aside class="col-12 col-lg-4 order-1 order-lg-2 mb-5 mb-lg-0">
          <section class="story-details">
            <div class="card story-details-card">
              <ul class="list-group list-group-flush rounded">
            {industryItems.length > 0 && (
              <li class="list-group-item story-details__item">
                <h3 class="story-details__heading">Industry</h3>
                <ul class="story-details__list">
                  {industryItems.map((item) => <li>{item}</li>)}
                </ul>
              </li>
            )}

            {marketsItems.length > 0 && (
              <li class="list-group-item story-details__item">
                <h3 class="story-details__heading">Markets Served</h3>
                <ul class="story-details__list">
                  {marketsItems.map((item) => <li>{item}</li>)}
                </ul>
              </li>
            )}

            {challengeItems.length > 0 && (
              <li class="list-group-item story-details__item">
                <h3 class="story-details__heading">Top Challenges</h3>
                <ul class="story-details__list">
                  {challengeItems.map((item) => <li>{item}</li>)}
                </ul>
              </li>
            )}

            {whyItems.length > 0 && (
              <li class="list-group-item story-details__item">
                <h3 class="story-details__heading">Why Reveal</h3>
                <ul class="story-details__list">
                  {whyItems.map((item) => <li>{item}</li>)}
                </ul>
              </li>
            )}
              </ul>
            </div>
          </section>
        </aside>
      )}
    </div>

    <style>
      .story-header {
        background: #fff;
      }

      .story-header__title {
        color: #1f2632;
        font-size: clamp(2rem, 4vw, 3rem);
        line-height: 1.15;
        margin-bottom: 1rem;
      }

      .customer-stories__logo,
      .customer-stories_logo {
        display: inline-block;
        max-width: 200px;
        width: auto;
        height: auto;
        margin-bottom: 1rem;
      }

      .story-header__image {
        width: 100%;
        max-width: 560px;
        height: auto;
        border-radius: 0.5rem;
      }

      .story-body {
        min-width: 0;
      }

      .story-details {
        position: sticky;
        top: 1.5rem;
      }

      .story-details-card {
        border: 1px solid #dbe3ee;
        border-radius: 0.5rem;
        background: #fff;
        overflow: hidden;
      }

      .story-details__item {
        padding: 1.1rem 1.2rem;
      }

      .story-details__heading {
        font-size: 1.05rem;
        margin-bottom: 0.55rem;
        font-weight: bold;
        color: #1f2632;
      }

      .story-details__list {
        margin: 0;
        padding-left: 1.15rem;
        list-style-type: disc;
      }

      .story-details__list li {
        margin-bottom: 0.45rem;
      }

      @media (max-width: 991.98px) {
        .story-details {
          position: static;
        }
      }
    </style>

    <style is:global>
      .story-page .wp-block-pullquote.is-style-default {
        border-top: 2px solid #ddd;
        border-bottom: 2px solid #ddd;
        margin: 2.25rem 0;
        padding: 4em 0;
      }

      .story-page .wp-block-pullquote.is-style-default blockquote {
        margin: 0;
        padding: 0.35rem 0;
        border: 0;
        text-align: center;
      }

      .story-page .wp-block-pullquote.is-style-default blockquote::before {
        color: #ec417a;
        content: '\201C';
        display: inline;
        font-family: Perpetua, Baskerville, Baskerville Old Face, Hoefler Text, Times New Roman, serif;
        font-size: 5.5rem;
        line-height: 0;
        height: 0;
        left: 0;
        position: relative;
        top: 36px;
      }

      .story-page .wp-block-pullquote.is-style-default p {
        color: #1f2632;
        font-size: 1.5em;
        line-height: 1.6;
        margin-bottom: 0.65rem;
      }

      .story-page .wp-block-pullquote.is-style-default cite {
        font-size: 1.5em;
        font-style: normal;
      }
    </style>
  </div>
</BaseLayout>
