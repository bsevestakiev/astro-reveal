---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'

const allStories = await getCollection('stories')
const stories = allStories.filter(s => s.id.startsWith('en/'))

const preferredOrder = [
  'synergy-logistics-elevating-warehouse-visibility-and-operational-intelligence-with-reveal',
  'commodity-centre',
  'lanxing-drives-data-driven-decision-making-in-the-supply-chain-with-reveal',
  'scriptly-helps-pharmacies-identify-trends-in-real-time-with-reveal',
  'datacom-case-study',
  'overwhelming-data-easy-to-digest-and-use-for-decision-making-with-reveal',
  'avion',
  'sensato',
  'casebook',
  'atanasoft',
]

const summaryOverrides: Record<string, string> = {
  'synergy-logistics-elevating-warehouse-visibility-and-operational-intelligence-with-reveal': 'Synergy Logistics is a trusted provider of warehouse management solutions, helping global enterprises streamline, automate, and optimize operations for over 50 years.',
  'commodity-centre': 'Commodity Centre is set to expand its use of Reveal, including the introduction of container tracking and enhanced environmental condition monitoring in the near future.',
  'datacom-case-study': 'Datacom\'s internal portal, "Zeus" manages tens of thousands of CMDB CI items, security and other technical information that is visualized and available in a single portal. However, it was difficult for end users to filter through and find views and reports that were relevant to them. Learn how Reveal helped.',
  'overwhelming-data-easy-to-digest-and-use-for-decision-making-with-reveal': 'Adrenalin was able to save three months of development time by implementing Reveal\'s embedded analytics, reducing the time to rollout. Adrenalin customers are using Reveal to analyze real time HR data for people insights across HR process from hire to retire.',
  'avion': 'Avion chose to embed Reveal into its Avalon software because of the software\'s exceptional ability to provide highly customizable and easy-to-use embedded analytics tools and data visualizations, which end users can immediately understand and use to make data-driven decisions.',
  'sensato': 'Sensato dramatically accelerated its time-to-market using Reveal embedded analytics software. Customers can now visualize massive amounts of data captured during a cyber-attack and use these insights to harden their security defenses.',
  'casebook': 'Reveal\'s drag-and-drop simplicity lets non-technical caseworkers quickly generate charts and reports that funders, managers and licensing agencies require regularly.',
  'atanasoft': 'When large government agencies, banks, manufacturers and retail companies need to access big data stored in Teradata or other data warehouses, many turn to Atanasoft.',
}

const titleOverrides: Record<string, string> = {
  'synergy-logistics-elevating-warehouse-visibility-and-operational-intelligence-with-reveal': 'Elevating Warehouse Visibility and Operational Intelligence with Reveal',
  'commodity-centre': 'Commodity Centre - Elevating Real Time Visualization of Warehouse Data With Reveal',
  'lanxing-drives-data-driven-decision-making-in-the-supply-chain-with-reveal': 'Lanxing Drives Data-driven Decision Making in the Supply Chain with Reveal',
  'scriptly-helps-pharmacies-identify-trends-in-real-time-with-reveal': 'Scriptly Helps Pharmacies Identify Trends in Real Time with Reveal',
  'datacom-case-study': 'Reveal Brings Multiple Data Points into a Single Pane of Glass',
  'overwhelming-data-easy-to-digest-and-use-for-decision-making-with-reveal': 'Overwhelming Data: Easy to Digest and Use For Decision Making With Reveal',
  'avion': 'Avion Saves a Year of Development Time with Reveal Embedded Analytics Software',
  'sensato': 'Sensato Accelerates Time-to-Market by 10x',
  'casebook': 'Social Services Agencies Leave Paper and Excel Spreadsheets Behind',
  'atanasoft': 'Atanasoft Customers Visualize Complex Data in Ways Never Before Possible',
}

const storiesSorted = [...stories].sort((a, b) => {
  const aSlug = a.id.replace(/^en\//, '')
  const bSlug = b.id.replace(/^en\//, '')
  const ai = preferredOrder.indexOf(aSlug)
  const bi = preferredOrder.indexOf(bSlug)
  if (ai === -1 && bi === -1) return aSlug.localeCompare(bSlug)
  if (ai === -1) return 1
  if (bi === -1) return -1
  return ai - bi
})

---

<BaseLayout
  title="Customer Stories | Reveal"
  description="See how companies around the world embed analytics with Reveal."
>
  <section class="stories-hero py-5">
    <div class="container">
      <div class="row justify-content-center text-center">
        <div class="col-12 col-lg-9">
          <h1 class="stories-hero__title mb-3">Successful Teams Using Reveal</h1>
          <p class="stories-hero__subhead mb-0">Learn more about how Reveal has helped teams get extraordinary results by empowering high performing teams</p>
        </div>
      </div>
    </div>
  </section>

  <div class="container py-5">
    <div class="row">
      {storiesSorted.map(story => {
        const slug = story.id.replace(/^en\//, '')
        const displayTitle = titleOverrides[slug] ?? story.data.title
        const displaySummary = summaryOverrides[slug] ?? story.data.description
        return (
          <div class="col-12 col-md-6 col-lg-4 mb-4">
            <article class="item-article card rounded-xl bg-white border-0 h-100 d-flex flex-column rounded-1rem story-card-shadow">
              <header style="background:#ebebf5;margin-bottom:0">
                <a href={`/stories/${slug}`} target="_self">
                  <img
                    loading="lazy"
                    decoding="async"
                    class="card-img-top mt-1 w-100 d-block"
                    style="border-top-left-radius:0.6rem;border-top-right-radius:0.6rem"
                    src={story.data.cover}
                    alt={displayTitle}
                  />
                </a>

                <div class="px-3 pt-3 bg-white">
                  {story.data.logo && (
                    <img
                      loading="lazy"
                      decoding="async"
                      src={story.data.logo}
                      alt={`${displayTitle} logo`}
                      class="story-card-logo mt-2 mb-3"
                    />
                  )}
                </div>

                <h2 class="card-title px-3 mb-0 bg-white pb-2 text-feat-story">
                  <a class="text-dark font-weight-bold text-decoration-none" href={`/stories/${slug}`} target="_self">{displayTitle}</a>
                </h2>
              </header>

              <div class="card-body pt-0 d-flex flex-column">
                {displaySummary && <p class="story-summary mb-3">{displaySummary}</p>}
                <a class="card-link mt-auto" href={`/stories/${slug}`} target="_self">
                  <span class="align-text-top font-weight-bold">Read Story</span>
                  <span class="align-middle ml-1">
                    <img
                      loading="lazy"
                      decoding="async"
                      src="https://static.infragistics.com/marketing/slingshot/arrow-blue.svg"
                      class="card-arrow"
                      alt="Read Story"
                      width="16"
                      height="16"
                    />
                  </span>
                </a>
              </div>
            </article>
          </div>
        )
      })}
      {storiesSorted.length === 0 && (
        <div class="col-12"><p class="text-muted">Customer stories coming soon.</p></div>
      )}
    </div>

    <style>
      .stories-hero {
        background: #fff;
      }

      .stories-hero__title {
        font-size: clamp(2rem, 3.6vw, 3rem);
        color: #1e2633;
        font-weight: 700;
        line-height: 1.15;
      }

      .stories-hero__subhead {
        color: #4b5e77;
        font-size: 1rem;
        line-height: 1.6;
      }

      .story-card-shadow {
        box-shadow: 0 14px 28px rgba(16, 34, 66, 0.12);
      }

      .story-card-logo {
        max-width: 100%;
        width: auto;
        height: auto;
        margin-bottom: 0;
        max-height: 60px;
        max-width: 200px;
        object-fit: contain;
      }

      .story-summary {
        color: #3c4d63;
        font-size: 1rem;
        line-height: 1.62;
      }

      .text-feat-story a {
        line-height: 1.28;
        font-size: 1.38rem;
      }

      .card-link {
        font-size: 0.95rem;
      }
    </style>
  </div>
</BaseLayout>
