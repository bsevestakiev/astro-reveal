---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'

export async function getStaticPaths() {
  const entries = await getCollection('glossary')
  return entries
    .filter(e => e.id.startsWith('en/'))
    .map(entry => ({
      params: { slug: entry.id.replace(/^en\//, '') },
      props: { entry },
    }))
}

const { entry } = Astro.props
const { Content } = await render(entry)
const heading = entry.data.heading ?? entry.data.title
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <header class="container">
    <div class="row pt-5 pb-3">
      <div class="col">
        <nav aria-label="breadcrumbs" class="rank-math-breadcrumb">
          <p>
            <a href="/">Home</a>
            <span class="separator"> / </span>
            <a href="/glossary">Glossary Terms</a>
            <span class="separator"> / </span>
            <span class="last">{heading}</span>
          </p>
        </nav>
        <h1>{heading}</h1>
      </div>
    </div>
  </header>

  <div class="container">
    <article class="entry-content">
      <Content />
    </article>
  </div>
</BaseLayout>
